{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zawiya Tools",
  "version": "0.6.0",
  "identifier": "com.ahmedqa.zawiyatools",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zawiya Tools",
        "width": 1200,
        "height": 820,
        "minWidth": 820,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#0F172A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://raw.githubusercontent.com; style-src 'self'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Ahmed Marwan",
    "copyright": "© 2026 Ahmed Marwan",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/ahmed1blog-dot/zawiya-tools",
    "category": "Utility",
    "shortDescription": "Local file conversion tools",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/bin/": "bin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGRDUzQTAyREI3OTExNzgKUldSNEVYbmJBanJWdjFwa1N3UHpYRS80RjdUd1IvdUZVeGFLMXRzc2k2eEF6Ynl5ZW9EL2ZlMGcK",
      "endpoints": [
        "https://github.com/ahmed1blog-dot/zawiya-tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
